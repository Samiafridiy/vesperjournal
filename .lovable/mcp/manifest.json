{
  "version": 1,
  "sdk_version": "0.20.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ocjvfomsoplugrnsutwz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "vesper-journal-mcp",
      "version": "0.1.0",
      "title": "Vesper Journal"
    },
    "tools": [
      {
        "name": "list_recent_trades",
        "title": "List recent trades",
        "description": "List the signed-in trader's most recent trades from Vesper Journal, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 20,
              "description": "Max number of trades to return (1-100).",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_trade_stats",
        "title": "Get trade stats",
        "description": "Aggregate the signed-in trader's performance across a lookback window: trade count, wins, losses, breakevens, win rate, total P&L, and average R.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "days": {
              "default": 30,
              "description": "Lookback window in days (1-365).",
              "type": "integer",
              "minimum": 1,
              "maximum": 365
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_trading_rules",
        "title": "List trading rules",
        "description": "List the signed-in trader's personal trading rules from their Rule Book.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "activeOnly": {
              "default": true,
              "description": "If true, only return active rules.",
              "type": "boolean"
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_weekly_reviews",
        "title": "List weekly reviews",
        "description": "List the signed-in trader's weekly reviews, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "default": 8,
              "description": "Max reviews to return (1-52).",
              "type": "integer",
              "minimum": 1,
              "maximum": 52
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
